# Copy to .env.local and fill in. Never commit real secrets.

# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 0/1) ────────────────────────────────
# New key system: publishable = browser-safe (replaces anon),
# secret = server-only (replaces service_role). Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Admin (Phase 2) ─────────────────────────────────────
# Comma-separated emails allowed into /admin (must match a Supabase Auth user).
ADMIN_EMAILS=

# ── Email (Resend) — transactional email ────────────────
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=

# ── Mapbox — the Living Map (Phase 1) ───────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Razorpay — payments (Phase 2) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Claude / Mei — AI planner (Phase 3) ─────────────────
ANTHROPIC_API_KEY=

# ── Sentry (optional) ───────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
