# Public site URL used by Next.js metadata.
NEXT_PUBLIC_SITE_URL=https://travelspirene.com

# Server-only database credentials. Use a Supabase secret/service-role key,
# never an anon or publishable key, for the payment persistence routes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# PayU Hosted Checkout. Test mode is deliberately the default.
PAYU_ENVIRONMENT=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# PayU must be able to POST to this public HTTPS origin. For local testing use
# a trusted HTTPS tunnel; localhost cannot receive PayU callbacks/webhooks.
PAYU_PUBLIC_BASE_URL=https://your-public-test-origin.example

# Production stays blocked unless both values are explicitly changed.
PAYU_LIVE_ENABLED=false

# Transactional booking receipts. Verify travelspirene.com with the provider
# before using info@travelspirene.com as the sender in production.
RESEND_API_KEY=
PAYMENT_EMAIL_FROM=Travelspire North-East <info@travelspirene.com>
PAYMENT_NOTIFICATION_EMAILS=travelspirene82@gmail.com,singhatwork55@gmail.com
